# 수집기(docker compose 의 collector) 전용 — 복사해서 collector.env 로 쓰고 값 채우기 (collector.env 는 커밋 금지).
# 중앙(api·db)의 .env 와 나눠서, GitLab 토큰은 수집기 컨테이너에만 들어가게 한다.
# 서버에 SSH 키는 두지 않는다 — 수집기는 GitLab 만 읽고, 서버 compose 칸은 지난 수집 값을 이어 쓴다.

# 수집기 이름(화면 '수집기 꺼짐' 판단·작업이력에 보임)
CT_RUNNER_NAME=server-collector

# 자동 수집 — 매일 이 시각(시간대 기준)에 한 번. 비우면 버튼(수동)만.
# 그 시각에 수집기가 꺼져 있었으면 켜질 때 한 번 돌고, 그날 이미 버튼으로 모았으면 건너뜀.
CT_COLLECT_DAILY_AT=09:00
CT_COLLECT_TZ=Asia/Seoul
# 수집기 로그 시각도 같은 시간대로(컨테이너 기본은 UTC)
TZ=Asia/Seoul

# 서버가 스스로 적는 상태 파일(IdP 서버 status.json) — 수집기가 읽어 화면 맨 위에 정상 · 경보 · 모름 한 줄.
#   기본 /idp-status/status.json (서버의 상태 폴더를 이 경로로 읽기 전용으로 붙이는 건 서버 쪽 설정이 함)
#   이 기능을 안 쓰는 곳(로컬 등)은 빈 값으로 끔 — 켜 둔 채 파일이 없으면 화면에 '모름' 이 뜬다(정상으로 안 보이게)
# CT_IDP_STATUS_FILE=

# 금고(IdP) 접속 기록 요약 파일 — '접속 기록' 탭(운영자만). 기본 /idp-status/access.jsonl (같은 폴더)
#   안 쓰는 곳은 빈 값으로 끔 — 켜 둔 채 파일이 없으면 화면에 '못 봄'(빈 표로 안 보이게)
# CT_IDP_ACCESS_FILE=

# gw 에 실제로 들어간 기록(gw 가 5분마다 보고 → IdP 서버가 1분마다 씀) — '접속 기록' 탭의 '들어간 gw · 시각'.
#   기본 /idp-status/gw-logins.jsonl (같은 폴더). 빈 값이면 끔 — 켜 둔 채 파일이 없으면 '못 봄'(IdP 반영 전 포함)
# CT_IDP_GW_LOGINS_FILE=

# GitLab 읽기 토큰 — 권한 read_api(읽기만), 역할 Reporter(job 로그까지 읽힘). 사람 개인 토큰 대신 전용(봇) 토큰 권장.
# repo GitLab(코드 repo)
CT_GITLAB_URL=https://gitlab.example.com
CT_GITLAB_TOKEN=
# center GitLab(이미지 빌드·config, 별도 인스턴스)
CT_GITLAB_CENTER_URL=https://gitlab-center.example.com
CT_GITLAB_CENTER_TOKEN=
# 읽을 브랜치 — 비우면 프로젝트마다 GitLab 기본 브랜치
CT_GITLAB_REF=

# 회사망이 TLS 를 중간에서 바꾸면(인증서 오류) 그 루트 인증서를 포함한 묶음 파일 — docker-compose 에서 /targets 아래로 붙이기
# SSL_CERT_FILE=/targets/ca-bundle.pem
