# 복사해서 .env 로 쓰고 값 채우기 (.env 는 커밋 금지 — .gitignore 됨)

# === docker compose (db 컨테이너) ===
DB_NAME=controltower
DB_USER=ctower
DB_PASSWORD=change-me

# === 중앙 API + 러너 (공유) ===
CT_SECRET=change-me-too
# 러너↔중앙 공유 토큰 — 중앙이 검증하고 러너가 보낸다. 아무 문자열로 채우면 됨.
CT_API_TOKEN=change-me-runner-token
# 로컬 개발(컨테이너 밖) 용. compose 안에서는 compose 가 DATABASE_URL 주입.
DATABASE_URL=sqlite:///./controltower.db

# === 러너 (로컬 실행) ===
CT_CENTRAL_URL=http://127.0.0.1:8000
# ssh config 가 기본 경로가 아니면 지정 (Phase 0 은 시스템 ssh 가 이 파일을 사용)
# CT_SSH_CONFIG=~/.ssh/config
# CT_RUNNER_NAME=local-runner
