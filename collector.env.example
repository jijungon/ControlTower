# 수집기(docker compose 의 collector) 전용 — 복사해서 collector.env 로 쓰고 값 채우기 (collector.env 는 커밋 금지).
# 중앙(api·db)의 .env 와 나눠서, GitLab 토큰은 수집기 컨테이너에만 들어가게 한다.
# 서버에 SSH 키는 두지 않는다 — 수집기는 GitLab 만 읽고, 서버 compose 칸은 지난 수집 값을 이어 쓴다.

# 수집기 이름(화면 '수집기 꺼짐' 판단·작업이력에 보임)
CT_RUNNER_NAME=server-collector

# GitLab 읽기 토큰 — 권한 read_api(읽기만), 역할 Reporter(job 로그까지 읽힘). 사람 개인 토큰 대신 전용(봇) 토큰 권장.
# repo GitLab(코드 repo)
CT_GITLAB_URL=https://gitlab.example.com
CT_GITLAB_TOKEN=
# center GitLab(이미지 빌드·config, 별도 인스턴스)
CT_GITLAB_CENTER_URL=https://gitlab-center.example.com
CT_GITLAB_CENTER_TOKEN=
# 읽을 브랜치 — 비우면 프로젝트마다 GitLab 기본 브랜치
CT_GITLAB_REF=

# 회사망이 TLS 를 중간에서 바꾸면(인증서 오류) 그 루트 인증서를 포함한 묶음 파일 — docker-compose 에서 /targets 아래로 붙이기
# SSL_CERT_FILE=/targets/ca-bundle.pem
