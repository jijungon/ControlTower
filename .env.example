# 복사해서 .env 로 쓰고 값 채우기 (.env 는 커밋 금지 — .gitignore 됨)

# === docker compose (db 컨테이너) ===
DB_NAME=controltower
DB_USER=ctower
DB_PASSWORD=change-me

# === 중앙 API + 러너 (공유) ===
CT_SECRET=change-me-too
# 러너↔중앙 공유 토큰 — 중앙이 검증하고 러너가 보낸다. 아무 문자열로 채우면 됨.
CT_API_TOKEN=change-me-runner-token
# 로컬 개발(컨테이너 밖) 용. compose 안에서는 compose 가 DATABASE_URL 주입.
DATABASE_URL=sqlite:///./controltower.db
# compose 호스트 포트 (충돌 시 변경). 기본 api 8000 / web 8090
# API_PORT=8000
# WEB_PORT=8090
# 포트 바인딩 주소. 로컬은 기본 127.0.0.1(외부 차단). 사내 VM 배포 시 0.0.0.0 로 열어 러너가 접근.
# BIND_ADDR=0.0.0.0
# postgres 데이터 디렉토리(호스트 bind mount). 기본 ./data/pgdata (repo 아래).
# PG_DATA_DIR=./data/pgdata

# === 러너 (로컬 실행) ===
CT_CENTRAL_URL=http://127.0.0.1:8000
# ssh config 가 기본 경로가 아니면 지정 (Phase 0 은 시스템 ssh 가 이 파일을 사용)
# CT_SSH_CONFIG=~/.ssh/config
# CT_RUNNER_NAME=local-runner
# GitLab — runner shape 는 기본으로 여기서 읽는다(대상 파일의 repo:/center:/project:). 토큰이 없으면 멈춤.
#   토큰은 러너 로컬에만(중앙엔 안 올라감). 권한 read_api(읽기만), 역할 Reporter(job 로그까지 읽힘), 만료 1년.
# repo GitLab(코드 repo)
# CT_GITLAB_URL=https://gitlab.example.com
# CT_GITLAB_TOKEN=glpat-xxxxxxxx
# center GitLab(이미지 빌드·config, 별도 인스턴스)
# CT_GITLAB_CENTER_URL=https://gitlab-center.example.com
# CT_GITLAB_CENTER_TOKEN=glpat-xxxxxxxx
# 읽을 브랜치 — 비우면 프로젝트마다 GitLab 기본 브랜치(main·dev 등)
# CT_GITLAB_REF=
# 회사망이 TLS 를 중간에서 바꾸면(인증서 오류) 그 루트 인증서를 포함한 묶음 파일을 지정
# SSL_CERT_FILE=/path/to/ca-bundle.pem
# CT_SHAPE_TARGETS=shape-targets.yml
# docker compose 의 수집기(collector) — GitLab 토큰 등은 collector.env 에 따로(collector.env.example 참고).
# 여기선 수집기가 읽을 대상 파일(호스트 경로)과 collector.env 위치만
# CT_SHAPE_TARGETS_FILE=./shape-targets.yml
# CT_COLLECTOR_ENV_FILE=./collector.env
# conf 적용(runner apply) — root 소유 conf 를 쓰려면 sudo(=1, passwordless 전제). 기본은 직접 쓰기.
# CT_APPLY_SUDO=1
